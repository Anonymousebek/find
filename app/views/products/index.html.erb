<%= turbo_stream_from "products" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<% content_for :title, "Products" %>

<div class="w-full">
  <% if notice.present? %>
    <p
      class="
        py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block
      "
      id="notice"
    ><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center pb-8">
    <h1 class="font-bold text-4xl">Products</h1>
  </div>

  <div>
    <ul class="flex flex-col gap-1">
      <% @products.each do |product| %>
        <li
          class="
            flex flex-col md:flex-row odd:bg-green-50 even:bg-white rounded p-2 md:p-0
          "
        >
          <p class="shrink-0 md:p-2">
            <%= if product.image.attached?
              image_tag product.image, class: "w-40 h-auto", alt: product.title
            else
              image_tag "/placeholder.png", class: "w-40 h-auto", alt: "No image available"
            end %>
          </p>
          <div class="flex flex-col justify-center md:px-2">
            <h2 class="text-xl font-bold"><%= product.title %></h2>
            <p class="my-3">
              <%= truncate(strip_tags(product.description), length: 80) %>
            </p>
            <p>
              <%= number_to_currency(product.price) %>
            </p>
          </div>
          <ul
            class="
              flex flex-row justify-start items-center gap-2 py-2 md:ml-auto md:justify-center
              md:items-end md:flex-col md:pr-2
            "
          >
            <li>
              <%= link_to "Show", product, class: "hover:underline" %>
            </li>
            <li>
              <%= link_to "Edit", edit_product_path(product), class: "hover:underline" %>
            </li>
            <li>
              <%= button_to "Destroy",
              product,
              method: :delete,
              class: "hover:underline",
              data: {
                turbo_confirm: "Are you sure?",
              } %>
            </li>
          </ul>
        </li>
      <% end %>
    </ul>

    <p class="flex justify-center mt-8 py-5 border-t border-gray-300 ">
      <%= link_to "New product",
      new_product_path,
      class: "inline rounded-lg py-3 px-5 bg-green-600 text-white block font-medium" %>
    </p>
  </div>
</div>
