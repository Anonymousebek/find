<%= turbo_stream_from "products" %>

<div class="w-full">
  <%= render "notice" %>
  <%= render "alert" %>

  <h2 class="font-bold text-xl mb-3 pb-2 border-b-2">Books Catalog</h2>

  <ul class="flex flex-col divide-y divide-gray-200">
    <% cache @products do %>
      <% @products.each do |product| %>
        <% cache product do %>
          <%= render partial: "product", object: product %>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</div>
