<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Find Online Books Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Find">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col">
    <header class="flex flex-row items-center bg-green-700 text-gray-100">
      <%= image_tag "logo.svg", alt: "Find Online Bookshelf" %>
      <h1><%= @page_title %></h1>
      <div class="ml-auto mr-6 hover:underline">
        <%= link_to "Cart", cart_path %>
      </div>
    </header>
    <section class="flex h-full">
      <nav class="bg-green-900 p-4 min-w-60 max-w-60 min-h-screen">
        <div class="sticky top-0">
          <ul class="text-gray-100 leading-8">
            <li><%= link_to "Home", root_path, class: "hover:text-white" %></li>
            <li><%= link_to "Questions", store_index_path, class: "hover:text-white" %></li>
            <li><%= link_to "News", store_index_path, class: "hover:text-white" %></li>
            <li><%= link_to "Contact", store_index_path, class: "hover:text-white" %></li>
            <li><%= link_to "Products", products_path, class: "hover:text-white" %></li>
          </ul>
          <%= turbo_stream_from @cart %>
          <%= render "layouts/cart", cart: @cart %>
        </div>
      </nav>
      <main class="container mx-auto mt-4 px-5 py-2 flex">
        <%= yield %>
      </main>
    </section>
  </body>
</html>
