<div class="flex flex-col">
  <h2 class="font-bold text-lg mb-3">Your Cart</h2>

  <div class="divide-y border-t">
    <% if cart.line_items.any? %>
      <%= render cart.line_items %>
    <% else %>
      <div class="p-2 text-black/70 text-center">Cart is empty</div>
    <% end %>
    <div class="flex font-bold p-1">
      <p class="ml-auto mr-3">
        Total:
      </p>
      <p>
        <%= number_to_currency cart.total_price %>
      </p>
    </div>
  </div>

  <% unless cart.line_items.empty? %>
    <%= button_to "Empty Cart",
    cart_url,
    method: :delete,
    class:
      "ml-auto cursor-pointer px-3 py-1 bg-blue-400 text-white rounded-lg hover:opacity-90" %>
  <% end %>
</div>
